using "ui/basic.style";
using "ui/colors.palette";

sexcatBadgeSize: 14px;
sexcatBadgeShift: margins(6px, 6px, 6px, 6px);
// WHY: the badge sits on media, so it needs a service-blue chip with a
// light glyph; the old white-on-white pairing rendered as a blank box.
sexcatBadgeFg: msgServiceFg;
sexcatBadgeFgHover: msgServiceFg;
sexcatBadgeFgSelected: msgServiceFg;
sexcatBadgeBg: msgServiceBg;
sexcatBadgeBgHover: msgServiceBgSelected;
sexcatBadgeBgSelected: msgServiceBgSelected;

sexcatBadgeIcon: icon{
	{ size(14px, 14px), sexcatBadgeBg },
	{ "sexcat/saved", sexcatBadgeFg },
};

sexcatBadgeIconHover: icon{
	{ size(14px, 14px), sexcatBadgeBgHover },
	{ "sexcat/saved", sexcatBadgeFgHover },
};

sexcatBadgeIconSelected: icon{
	{ size(14px, 14px), sexcatBadgeBgSelected },
	{ "sexcat/saved", sexcatBadgeFgSelected },
};

sexcatHistoryWindowSize: size(960px, 640px);
